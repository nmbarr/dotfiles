# ####################################################
# Shell Aliases that are common to both bash and zsh
# These aliases are sourced in both .bashrc and .zshrc
# ####################################################

# General
alias vim='nvim'

# git aliases
alias gs='git status'
alias ga='git add'
alias gco='git checkout'
alias gcm='git commit -m'
alias gp='git push'
alias gl='git pull'

# Directory navigation aliases
alias ..='cd ..'
alias ...='cd ../..'
alias .3='cd ../../..'
alias .4='cd ../../../..'
alias .5='cd ../../../../..'

# ls aliases - use eza if available, otherwise fallback to ls
if command -v eza &> /dev/null; then
    alias ls='eza -lah'           # long format with all files using eza
    alias lc='eza -CF'            # compact columnar view using eza
else
    alias ls='ls -lah --color=auto'   # default: no hidden files
    alias lc='ls -CF --color=auto'    # compact columnar view
fi

# Editor aliases
alias brc='${EDITOR:-nvim} ~/.bashrc && source ~/.bashrc'
alias ali='${EDITOR:-nvim} ~/.shell_aliases && source ~/.shell_aliases'
alias ufn='${EDITOR:-nvim} ~/.user_functions && source ~/.user_functions'

# -----------------------------------
# WINDOWS ALIASES
# -----------------------------------
alias oe='explorer.exe .'
